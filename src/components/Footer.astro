---
interface Props {
  name: string;
}

const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex w-full max-w-[var(--container-content)] flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-ink-faint md:flex-row md:px-10">
    <p>© {year} {name}. Built with Astro, React &amp; Sanity.</p>
    <a href="#main-content" class="underline decoration-border underline-offset-4 hover:text-ink">
      Back to top
    </a>
  </div>
</footer>
