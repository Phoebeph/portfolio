---
import { skillGroups } from "../data/skills";
---

<section id="skills" class="border-t border-border bg-paper-dim">
  <div class="mx-auto w-full max-w-[var(--container-content)] scroll-mt-20 px-6 py-20 md:px-10">
    <h2 class="font-display text-3xl text-ink">Technical skills</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="text-sm tracking-wide text-ink-faint uppercase">
              {group.category}
            </h3>
            <ul class="mt-3 space-y-2">
              {group.items.map((item) => (
                <li class="text-ink-soft">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
