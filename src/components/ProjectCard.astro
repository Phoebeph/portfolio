---
import type { Project } from "../lib/sanity/types";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="group border-t border-border py-10 first:border-t-0 md:grid md:grid-cols-[auto_1fr] md:gap-10">
  <div class="flex items-center justify-center border border-border bg-paper-dim md:h-full md:w-40">
    <span class="font-display text-2xl text-ink-faint">
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>

  <div class="mt-6 md:mt-0">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h3 class="font-display text-2xl text-ink">{project.title}</h3>
      <div class="flex gap-4 text-sm">
        {
          project.liveUrl && (
            <a
              href={project.liveUrl}
              class="text-ink-soft underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >
              Live site
            </a>
          )
        }
        {
          project.repoUrl && (
            <a
              href={project.repoUrl}
              class="text-ink-soft underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >
              Source
            </a>
          )
        }
      </div>
    </div>

    <p class="mt-3 max-w-2xl text-ink-soft">{project.description}</p>

    {
      project.techStack && project.techStack.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2 text-xs text-ink-soft">
          {project.techStack.map((tech) => (
            <li class="border border-border px-2.5 py-1">{tech}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
